---
import '../styles/global.css';

const phone = '5512982208667';
const whatsapp = (message: string) => `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
const instagram = 'https://www.instagram.com/design18ksjc/';

const categories = [
  {
    label: 'Alianças',
    detail: 'Para dividir uma vida inteira.',
    image: 'assets/instagram/aliancas-ouro.jpg',
    alt: 'Publicação da Design18k com um par de alianças de ouro',
    href: 'https://www.instagram.com/design18ksjc/p/Dc6ILUYiCQ_/',
  },
  {
    label: 'Anéis',
    detail: 'Pequenos gestos, grandes histórias.',
    image: 'assets/instagram/anel-ouro.jpg',
    alt: 'Publicação da Design18k com anel dourado e pedra central',
    href: 'https://www.instagram.com/design18ksjc/p/Dc1uiytiUkn/',
  },
  {
    label: 'Brincos',
    detail: 'Detalhes que acompanham você.',
    image: 'assets/instagram/brincos-perola.jpg',
    alt: 'Publicação da Design18k com par de brincos dourados e pérolas',
    href: 'https://www.instagram.com/design18ksjc/p/Dc6_DWBCMcQ/',
  },
];

const feed = [
  { image: 'assets/instagram/aliancas-solitario.jpg', alt: 'Aliança e solitário em ouro, publicação da Design18k', href: 'https://www.instagram.com/design18ksjc/p/Dd6gdkTIJfq/' },
  { image: 'assets/instagram/brincos-ouro.jpg', alt: 'Brincos de ouro em expositor branco', href: 'https://www.instagram.com/design18ksjc/p/Dc_K1dODevk/' },
  { image: 'assets/instagram/pulseira-ouro.jpg', alt: 'Pulseira de ouro em publicação da Design18k', href: 'https://www.instagram.com/design18ksjc/p/Dc8mE2SD32t/' },
  { image: 'assets/instagram/colar-azul.jpg', alt: 'Colar com pedra azul publicado pela Design18k', href: 'https://www.instagram.com/design18ksjc/reel/Dc9j2WOihhf/' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'JewelryStore',
  name: 'Design18k Joias',
  url: Astro.url.href,
  telephone: '+55-12-98220-8667',
  sameAs: [instagram],
  address: { '@type': 'PostalAddress', addressLocality: 'São José dos Campos', addressRegion: 'SP', addressCountry: 'BR' },
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#11120f" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <title>Design18k Joias | Joias para eternizar momentos</title>
    <meta name="description" content="Conheça alianças, anéis e joias da Design18k em São José dos Campos. Peças para eternizar momentos e atendimento próximo pelo WhatsApp." />
    <link rel="canonical" href={Astro.url.href} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content="Design18k Joias | Joias para eternizar momentos" />
    <meta property="og:description" content="Alianças, anéis e detalhes que acompanham a sua história." />
    <meta property="og:image" content={new URL('assets/instagram/aliancas-solitario.jpg', Astro.url).href} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <div class="announcement">Design18k Joias <span>✦</span> São José dos Campos</div>

    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="#inicio" aria-label="Design18k Joias, início"><span class="brand-main">DESIGN<span>18K</span></span><span class="brand-sub">JOIAS · OURO 750</span></a>
        <nav class="desktop-nav" aria-label="Navegação principal"><a href="#joias">Joias</a><a href="#aliancas">Alianças</a><a href="#essencia">Nossa essência</a><a href="#instagram">Instagram</a></nav>
        <a class="header-cta" href={whatsapp('Olá! Vim pelo site e gostaria de conhecer as joias da Design18k.')} target="_blank" rel="noopener noreferrer">Falar no WhatsApp <span aria-hidden="true">↗</span></a>
        <button class="menu-toggle" type="button" aria-label="Abrir menu" aria-controls="mobile-nav" aria-expanded="false"><span></span><span></span></button>
      </div>
      <nav class="mobile-nav" id="mobile-nav" aria-label="Navegação móvel" hidden><a href="#joias">Joias</a><a href="#aliancas">Alianças</a><a href="#essencia">Nossa essência</a><a href="#instagram">Instagram</a><a href={whatsapp('Olá! Vim pelo site e gostaria de conhecer as joias da Design18k.')} target="_blank" rel="noopener noreferrer">Falar no WhatsApp ↗</a></nav>
    </header>

    <main id="conteudo">
      <section class="hero" id="inicio" aria-labelledby="hero-title">
        <div class="container hero-inner">
          <div class="hero-copy reveal"><span class="eyebrow">A joia é só o começo</span><h1 id="hero-title">Momentos que<br />merecem <em>brilhar.</em></h1><p>Joias para celebrar o que é seu: encontros, conquistas e histórias que permanecem.</p><div class="hero-actions"><a class="button button-gold" href="#joias">Conheça nossas joias <span aria-hidden="true">↗</span></a><a class="text-link text-link-light" href="#aliancas">Descubra as alianças <span aria-hidden="true">↗</span></a></div><span class="hero-side-note">DESIGN18K · SÃO JOSÉ DOS CAMPOS</span></div>
          <div class="hero-images"><div class="hero-ring reveal"><img src="assets/instagram/anel-em-uso.jpg" alt="Anel da Design18k usado na mão, imagem publicada no Instagram da marca" width="360" height="640" fetchpriority="high" /><span>Um detalhe que conta uma história.</span></div><div class="hero-detail reveal"><img src="assets/instagram/aliancas-detalhe.jpg" alt="Close de alianças douradas publicado pela Design18k" width="360" height="640" loading="lazy" /></div><span class="hero-ornament" aria-hidden="true">✦</span></div>
        </div>
        <div class="container hero-bottom"><span>Joias que eternizam momentos</span><span>Role para descobrir ↓</span></div>
      </section>

      <section class="intro-band" aria-label="Mensagem da marca"><div class="container intro-band-inner"><span class="eyebrow">Design18k Joias</span><p>O presente vira lembrança. A promessa vira símbolo. E cada joia encontra seu lugar na sua história.</p><span class="intro-spark" aria-hidden="true">✦</span></div></section>

      <section class="section categories" id="joias" aria-labelledby="jewels-title"><div class="container"><div class="section-heading reveal"><div><span class="eyebrow">01 / Explore</span><h2 id="jewels-title">Seu estilo. <em>Sua joia.</em></h2></div><p>Uma seleção de peças compartilhadas pela própria Design18k. Descubra o detalhe que combina com você.</p></div><div class="category-grid">{categories.map((item, index) => <a class="category-card reveal" href={item.href} target="_blank" rel="noopener noreferrer"><span class="category-index">0{index + 1} / 03</span><div class="category-image"><img src={item.image} alt={item.alt} width="640" height="640" loading="lazy" /></div><div class="category-meta"><div><h3>{item.label}</h3><p>{item.detail}</p></div><span aria-hidden="true">↗</span></div></a>)}</div></div></section>

      <section class="alliances section" id="aliancas" aria-labelledby="alliances-title"><div class="container alliance-grid"><div class="alliance-image reveal"><img src="assets/instagram/aliancas-solitario.jpg" alt="Publicação da Design18k mostrando alianças e solitário em ouro" width="640" height="640" loading="lazy" /><span>Da nossa coleção no Instagram</span></div><div class="alliance-copy reveal"><span class="eyebrow">02 / Alianças & solitários</span><h2 id="alliances-title">O começo de um <em>para sempre.</em></h2><p>Para quem escolheu dividir a vida, os detalhes fazem toda a diferença. Encontre o símbolo que combina com a história de vocês.</p><div class="alliance-points"><span>Alianças</span><span>Solitários</span><span>Ouro 18k</span></div><a class="button button-dark" href={whatsapp('Olá! Gostaria de conhecer as alianças e solitários da Design18k.')} target="_blank" rel="noopener noreferrer">Conversar sobre alianças <span aria-hidden="true">↗</span></a></div></div></section>

      <section class="real-moments" id="essencia" aria-labelledby="moments-title"><div class="real-photo reveal"><img src="assets/instagram/anel-em-uso.jpg" alt="Anel da Design18k na mão de uma cliente, imagem do Instagram" width="360" height="640" loading="lazy" /></div><div class="real-copy reveal"><span class="eyebrow">03 / Momentos reais</span><h2 id="moments-title">Feita para estar <em>com você.</em></h2><p>A beleza de uma joia aparece de verdade quando ela passa a fazer parte do dia a dia. Na mão, na memória e nos momentos que ainda virão.</p><a class="text-link" href={instagram} target="_blank" rel="noopener noreferrer">Veja mais no Instagram <span aria-hidden="true">↗</span></a></div><div class="real-box reveal"><img src="assets/instagram/embalagem.jpg" alt="Caixa de joia com a marca Design18k, apresentada no Instagram" width="360" height="640" loading="lazy" /></div></section>

      <section class="section service-section" aria-labelledby="service-title"><div class="container"><div class="service-top reveal"><span class="eyebrow">04 / Uma conversa, muitas possibilidades</span><h2 id="service-title">Cada história pede um <em>cuidado diferente.</em></h2></div><div class="service-grid"><div class="service-item reveal"><span>01</span><h3>Joias sob medida</h3><p>Uma ideia especial merece atenção a cada detalhe. Conte o que você imagina para a nossa equipe.</p></div><div class="service-item reveal"><span>02</span><h3>Reformas</h3><p>Peças que já carregam uma história podem ganhar novos capítulos.</p></div><div class="service-item reveal"><span>03</span><h3>Avaliação de ouro</h3><p>Converse com a equipe sobre suas peças e as possibilidades de avaliação.</p></div></div><a class="text-link" href={whatsapp('Olá! Gostaria de conversar sobre os serviços da Design18k.')} target="_blank" rel="noopener noreferrer">Fale com a Design18k <span aria-hidden="true">↗</span></a></div></section>

      <section class="feed-section" id="instagram" aria-labelledby="feed-title"><div class="container"><div class="feed-heading reveal"><div><span class="eyebrow">05 / No Instagram</span><h2 id="feed-title">Acompanhe os <em>detalhes.</em></h2></div><a class="text-link" href={instagram} target="_blank" rel="noopener noreferrer">@design18ksjc <span aria-hidden="true">↗</span></a></div><div class="feed-grid">{feed.map((post) => <a class="feed-card reveal" href={post.href} target="_blank" rel="noopener noreferrer" aria-label="Ver publicação da Design18k no Instagram"><img src={post.image} alt={post.alt} width="640" height="640" loading="lazy" /><span aria-hidden="true">↗</span></a>)}</div><p class="feed-caption">Imagens publicadas pela Design18k em <a href={instagram} target="_blank" rel="noopener noreferrer">@design18ksjc</a>.</p></div></section>

      <section class="visit" id="visite" aria-labelledby="visit-title"><div class="container visit-grid"><div class="visit-image reveal"><img src="assets/instagram/embalagem.jpg" alt="Embalagem de joia com a marca Design18k" width="360" height="640" loading="lazy" /></div><div class="visit-copy reveal"><span class="eyebrow">06 / Venha nos conhecer</span><h2 id="visit-title">O próximo capítulo começa <em>aqui.</em></h2><p>Estamos no Shopping Jardim Oriente, em São José dos Campos. Venha conversar com a gente e encontrar a joia para o seu momento.</p><div class="visit-actions"><a class="button button-gold" href={whatsapp('Olá! Gostaria de visitar a Design18k no Shopping Jardim Oriente.')} target="_blank" rel="noopener noreferrer">Falar no WhatsApp <span aria-hidden="true">↗</span></a><a class="text-link text-link-light" href="https://www.google.com/maps/search/?api=1&query=Design18k+Joias+Shopping+Jardim+Oriente+Sao+Jose+dos+Campos" target="_blank" rel="noopener noreferrer">Como chegar <span aria-hidden="true">↗</span></a></div></div></div></section>
    </main>

    <footer class="site-footer"><div class="container footer-main"><div><a class="brand brand-footer" href="#inicio" aria-label="Design18k Joias, voltar ao início"><span class="brand-main">DESIGN<span>18K</span></span><span class="brand-sub">JOIAS · OURO 750</span></a><p>Joias que eternizam momentos.</p></div><nav aria-label="Links do rodapé"><a href="#joias">Joias</a><a href="#aliancas">Alianças</a><a href="#essencia">Nossa essência</a><a href="#visite">Visite-nos</a></nav><div class="footer-contact"><a href={instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a><a href={whatsapp('Olá! Gostaria de falar com a Design18k.')} target="_blank" rel="noopener noreferrer">WhatsApp ↗</a><a href="tel:+5512982208667">(12) 98220-8667</a></div></div><div class="container footer-bottom"><span>© {new Date().getFullYear()} Design18k Joias</span><span>São José dos Campos · SP</span><a href="#inicio">Voltar ao topo ↑</a></div></footer>
    <a class="mobile-whatsapp" href={whatsapp('Olá! Gostaria de falar com a Design18k.')} target="_blank" rel="noopener noreferrer">Falar no WhatsApp <span aria-hidden="true">↗</span></a>

    <script>
      const header = document.querySelector<HTMLElement>('.site-header');
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const mobileNav = document.querySelector<HTMLElement>('.mobile-nav');
      const floating = document.querySelector<HTMLElement>('.mobile-whatsapp');
      const onScroll = () => {
        header?.classList.toggle('scrolled', scrollY > 24);
        floating?.classList.toggle('visible', scrollY > innerHeight * .7);
      };
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();
      const closeMenu = () => {
        if (!toggle || !mobileNav) return;
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Abrir menu');
        mobileNav.hidden = true;
        document.body.classList.remove('menu-open');
      };
      toggle?.addEventListener('click', () => {
        if (!mobileNav) return;
        const open = toggle.getAttribute('aria-expanded') !== 'true';
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
        mobileNav.hidden = !open;
        document.body.classList.toggle('menu-open', open);
      });
      mobileNav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
      addEventListener('keydown', (event) => { if (event.key === 'Escape') closeMenu(); });
      matchMedia('(min-width: 961px)').addEventListener('change', (event) => { if (event.matches) closeMenu(); });
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const observer = new IntersectionObserver((entries, current) => entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); current.unobserve(entry.target); } }), { threshold: .08, rootMargin: '0px 0px -24px 0px' });
        document.querySelectorAll('.reveal').forEach((element) => observer.observe(element));
      } else document.querySelectorAll('.reveal').forEach((element) => element.classList.add('is-visible'));
    </script>
  </body>
</html>
